{
  "lang": "es",
  "apiVersion": 1,
  "version": 1,
  "status": "test",
  "contentRating": "safe",
  "network": {
    "baseUrl": "https://192.0.2.1",
    "rateLimits": [
      {
        "host": "main",
        "requests": 1,
        "seconds": 2
      },
      {
        "host": "panel",
        "requests": 2,
        "seconds": 1
      }
    ]
  },
  "content": {
    "seriesType": "comic",
    "detailPage": "/series/comic-{slug}",
    "chapterPage": "/capitulo/{chapterId}/comic-{slug}"
  },
  "endpoints": {
    "seriesList": "/api/series/list",
    "popular": "/api/rankings?page={page}&period=total_ranking",
    "latest": "/api/new-chapters?page={page}",
    "details": "/api/series/{slug}?type=comic",
    "chapters": {
      "url": "/api/series/{slug}/chapters?page={page}&direction=desc&type=comic",
      "host": "panel",
      "paginated": true
    },
    "pages": "/api/capitulo/comic-{slug}/{chapterId}"
  },
  "icon": "https://www.google.com/s2/favicons?domain=github.com&sz=128",
  "id": "escenario-timeout",
  "name": "Escenario: servidor congelado",
  "description": "PRUEBA. IP TEST-NET-1 (RFC 5737): jamas enrutable, el connect se cuelga. Reproduce TIEMPO_AGOTADO (5 s x 3 intentos)."
}