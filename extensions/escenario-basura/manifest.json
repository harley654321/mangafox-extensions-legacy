{
  "lang": "es",
  "apiVersion": 1,
  "version": 1,
  "status": "test",
  "contentRating": "safe",
  "network": {
    "baseUrl": "https://raw.githubusercontent.com/harley654321/mangafox-extensions/main/escenarios/basura",
    "rateLimits": [
      {
        "host": "main",
        "requests": 1,
        "seconds": 2
      },
      {
        "host": "panel",
        "requests": 2,
        "seconds": 1
      }
    ]
  },
  "content": {
    "seriesType": "comic",
    "detailPage": "/series/comic-{slug}",
    "chapterPage": "/capitulo/{chapterId}/comic-{slug}"
  },
  "endpoints": {
    "seriesList": "/api/series/list",
    "popular": "/api/rankings?page={page}&period=total_ranking",
    "latest": "/api/new-chapters?page={page}",
    "details": "/api/series/{slug}?type=comic",
    "chapters": {
      "url": "/api/series/{slug}/chapters?page={page}&direction=desc&type=comic",
      "host": "panel",
      "paginated": true
    },
    "pages": "/api/capitulo/comic-{slug}/{chapterId}"
  },
  "icon": "https://www.google.com/s2/favicons?domain=github.com&sz=128",
  "id": "escenario-basura",
  "name": "Escenario: respuesta basura",
  "description": "PRUEBA. Endpoints responden 200 con HTML en vez de JSON. Reproduce INESPERADO (cuerpo no-JSON)."
}